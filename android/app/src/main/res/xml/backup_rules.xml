<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: back up the user's own data (tickets, favourites, settings, notification
     preferences) and nothing else. The app is a native shell, so there is nothing else to protect — but
     being explicit means a future native file is excluded by default rather than backed up by accident. -->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
