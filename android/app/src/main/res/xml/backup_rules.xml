<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older.

     A single include is all that is needed, and it is deliberate: as soon as a rules file names what to back
     up, everything else stops being backed up. The app is a native shell whose user data is its own
     preferences (tickets, favourites, notification settings); the analysis and the live feed are re-fetched,
     and a downloaded update is never carried across. Lint's FullBackupContent check treats an exclude of a
     path that is not included as an error for exactly this reason — the exclude can never apply. -->
<full-backup-content>
    <include domain="sharedpref" path="." />
</full-backup-content>
