{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goals-scanner-timer",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "SCHEDULER", "class_name": "Scheduler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Scheduler"] }]
}
